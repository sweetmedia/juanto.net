{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "juanto/tutorial-meta",
  "title": "Tutorial facts",
  "category": "text",
  "description": "The tutorial's time, tools, last-tested date, requirements, result and video.",
  "textdomain": "juanto",
  "attributes": {
    "variant": {
      "type": "string",
      "enum": [
        "full",
        "row",
        "badge"
      ],
      "default": "full"
    }
  },
  "usesContext": [
    "postId"
  ],
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}