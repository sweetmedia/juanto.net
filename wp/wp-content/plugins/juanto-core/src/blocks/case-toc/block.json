{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "juanto/case-toc",
	"title": "Case study contents",
	"category": "text",
	"description": "Table of contents built from Section head blocks, or from tutorial steps.",
	"textdomain": "juanto",
	"attributes": { "source": { "type": "string", "enum": [ "section-head", "tutorial-step" ], "default": "section-head" } },
	"usesContext": [ "postId" ],
	"supports": { "html": false },
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
